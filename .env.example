# Database (PostgreSQL)
DATABASE_URL=postgres://paco:paco@localhost:5432/nextjs_starter

# pgBoss uses the same PostgreSQL database
PGBOSS_DATABASE_URL=postgres://paco:paco@localhost:5432/nextjs_starter

# ── BetterAuth ────────────────────────────────────────────────
# Generate a secret with: npx -y @better-auth/cli secret
# Or just run: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL — used by BetterAuth for callback URLs in OAuth
NEXT_PUBLIC_APP_URL=http://localhost:3003

# ── Google OAuth ──────────────────────────────────────────────
# Create an OAuth consent screen + client ID at:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP Email (for magic links & notifications) ─────────────
# Mailpit runs locally with SMTP auth enabled.
# See docs/auth.md for setup instructions.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=mailpit
SMTP_PASS=fBCdk95MS7K1ebMaYxBLfow5
SMTP_FROM=noreply@localhost

# ── Admin Management ─────────────────────────────────────────
# No ADMIN_EMAILS env var needed — use the CLI command instead:
#   pnpm make:admin user@example.com
# Or use the Orbit Admin UI at /orbit/users (set role dropdown).
