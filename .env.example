# Database (PostgreSQL)
DATABASE_URL=postgres://paco:paco@localhost:5432/nextjs_starter

# pgBoss uses the same PostgreSQL database
PGBOSS_DATABASE_URL=postgres://paco:paco@localhost:5432/nextjs_starter

# ── BetterAuth ────────────────────────────────────────────────
# Generate a secret with: npx -y @better-auth/cli secret
# Or just run: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL — used by BetterAuth for callback URLs in OAuth
NEXT_PUBLIC_APP_URL=http://localhost:3003

# ── Google OAuth ──────────────────────────────────────────────
# Create an OAuth consent screen + client ID at:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP Email (for magic links & notifications) ─────────────
# Magic-link emails are sent by the pgBoss worker, not the request handler.
# For local dev, Mailpit is the easiest option:
#   brew install mailpit && mailpit
# It listens on :1025 (SMTP) with a web UI on http://localhost:8025.
# Mailpit accepts any credentials unless you enable auth, so SMTP_USER and
# SMTP_PASS can be anything non-empty locally. NEVER commit real ones here.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# ── Admin Management ─────────────────────────────────────────
# There is no ADMIN_EMAILS variable — roles live in the database.
# Promote the FIRST admin from the command line:
#   pnpm make:admin user@example.com
# After that, manage roles in the Orbit Admin UI at /orbit/users.
