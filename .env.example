# Database (PostgreSQL)
# The same connection is used by Drizzle ORM and pgBoss (job queue).
# Point this at your own Postgres instance — local, Docker, or a cloud provider
# (Neon, Supabase, AWS RDS, etc.).
DATABASE_URL=postgres://postgres:password@localhost:5432/nextjs_starter

# pgBoss uses the same PostgreSQL database for its job queue tables.
# If different, set PGBOSS_DATABASE_URL separately; otherwise it falls back
# to DATABASE_URL.
PGBOSS_DATABASE_URL=postgres://postgres:password@localhost:5432/nextjs_starter
