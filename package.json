{
  "name": "@stack256org/nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "concurrently --names web,worker --prefix-colors cyan,magenta \"next dev --port 3003\" \"tsx src/lib/queue/worker.cli.ts\"",
    "dev:web": "next dev --port 3003",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && oxlint .",
    "lint:fix": "oxlint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate:run": "tsx src/lib/db/migrate.cli.ts",
    "worker": "tsx src/lib/queue/worker.cli.ts",
    "make:admin": "tsx src/lib/auth/make-admin.cli.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.7.2",
    "daisyui": "^5.7.22",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "pg-boss": "^12.28.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
